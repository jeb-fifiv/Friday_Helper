<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPersonalization"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_gray">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/warm_gray"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title=""
        app:navigationIcon="@null"
        app:titleTextColor="@color/default_accent" />

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="12dp"
            android:gravity="center"
            android:text="&lt;"
            android:textSize="28sp"
            android:textColor="@android:color/black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/action_cancel"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_personalization"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/greetingNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_greeting_name"
                android:textColor="@color/default_accent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/greetingNameInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_warm_gray"
                android:padding="12dp"
                android:hint="@string/hint_greeting_name"
                android:inputType="textPersonName"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/greetingNameLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/wakeWordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_wake_word"
                android:textColor="@color/default_accent"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/greetingNameInput"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/wakeWordInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_warm_gray"
                android:padding="12dp"
                android:hint="@string/hint_wake_word"
                android:inputType="text"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/wakeWordLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/fontLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_font"
                android:textColor="@color/default_accent"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/wakeWordInput"
                app:layout_constraintStart_toStartOf="parent" />

            <AutoCompleteTextView
                android:id="@+id/fontDropdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_warm_gray"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/fontLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/centerButtonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_center_button"
                android:textColor="@color/default_accent"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/fontDropdown"
                app:layout_constraintStart_toStartOf="parent" />

            <RadioGroup
                android:id="@+id/centerButtonGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/centerButtonLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <RadioButton
                    android:id="@+id/rbCenterCircleMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/center_button_circle_menu" />
                <RadioButton
                    android:id="@+id/rbCenterWaves"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/center_button_waves" />
            </RadioGroup>

            <TextView
                android:id="@+id/welcomeAnimationsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_welcome_animations"
                android:textColor="@color/default_accent"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/centerButtonGroup"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchWelcomeAnimations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                app:layout_constraintTop_toBottomOf="@id/welcomeAnimationsLabel"
                app:layout_constraintStart_toStartOf="parent" />

                <TextView
                android:id="@+id/voiceInputFormatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_voice_input_format"
                android:textColor="@color/default_accent"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/switchWelcomeAnimations"
                app:layout_constraintStart_toStartOf="parent" />

            <RadioGroup
                android:id="@+id/voiceInputFormatGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/voiceInputFormatLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <RadioButton
                    android:id="@+id/rbVoiceEditThenSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_input_edit_then_send" />
                <RadioButton
                    android:id="@+id/rbVoiceSendImmediately"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/voice_input_send_immediately" />
            </RadioGroup>

            <TextView
                android:id="@+id/callModeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_call_mode"
                android:textColor="@color/default_accent"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/voiceInputFormatGroup"
                app:layout_constraintStart_toStartOf="parent" />

            <RadioGroup
                android:id="@+id/callModeGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/callModeLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <RadioButton
                    android:id="@+id/rbCallModeContacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_mode_contacts" />
                <RadioButton
                    android:id="@+id/rbCallModeDirect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/call_mode_direct" />
            </RadioGroup>

            <Button
                android:id="@+id/applyButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_warm_gray"
                android:text="@string/action_apply"
                android:textColor="@color/default_accent"
                app:layout_constraintTop_toBottomOf="@id/callModeGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
