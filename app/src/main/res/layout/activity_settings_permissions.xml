<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPermissions"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_gray">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/warm_gray"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title=""
        app:navigationIcon="@null"
        app:titleTextColor="@color/default_accent" />

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="12dp"
            android:gravity="center"
            android:text="&lt;"
            android:textSize="28sp"
            android:textColor="@android:color/black"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/action_cancel"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_permissions"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/label_location"
                android:textColor="@color/default_accent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/locationHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hint_location"
                android:textColor="@color/default_accent"
                android:alpha="0.8"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/switchLocation"
                app:layout_constraintStart_toStartOf="@id/switchLocation"
                app:layout_constraintEnd_toEndOf="@id/switchLocation" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchClock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_clock"
                android:textColor="@color/default_accent"
                app:layout_constraintTop_toBottomOf="@id/locationHint"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/clockHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hint_clock"
                android:textColor="@color/default_accent"
                android:alpha="0.8"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/switchClock"
                app:layout_constraintStart_toStartOf="@id/switchClock"
                app:layout_constraintEnd_toEndOf="@id/switchClock" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMicrophone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_microphone"
                android:textColor="@color/default_accent"
                app:layout_constraintTop_toBottomOf="@id/clockHint"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/microphoneHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hint_microphone"
                android:textColor="@color/default_accent"
                android:alpha="0.8"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/switchMicrophone"
                app:layout_constraintStart_toStartOf="@id/switchMicrophone"
                app:layout_constraintEnd_toEndOf="@id/switchMicrophone" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchContacts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_contacts"
                android:textColor="@color/default_accent"
                app:layout_constraintTop_toBottomOf="@id/microphoneHint"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/contactsHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hint_contacts"
                android:textColor="@color/default_accent"
                android:alpha="0.8"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/switchContacts"
                app:layout_constraintStart_toStartOf="@id/switchContacts"
                app:layout_constraintEnd_toEndOf="@id/switchContacts" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
