<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootWelcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:background="#E8E8E8">

    <ImageView
        android:id="@+id/welcomeGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/welcomeGsa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_gsa"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:alpha="0"
            android:layout_marginEnd="16dp" />

        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:minWidth="110dp"
            android:minHeight="110dp">

            <View
                android:id="@+id/welcomeCircle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_welcome_circle_white" />

            <ImageView
                android:id="@+id/welcomeGif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="19dp"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/welcomeCreatedByBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:alpha="0"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/welcomeCreatedBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_created_by"
                android:textSize="14sp"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/welcomeCursor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_cursor"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/welcomeDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:alpha="0"
        android:clickable="true"
        android:focusable="true" />
</FrameLayout>
